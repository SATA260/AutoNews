{
  "name": "aidaily-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/cli-bridge",
    "packages/tts",
    "packages/core",
    "apps/cli",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w apps/web",
    "typecheck": "npm run build -w @aidaily/contracts && npm run build -w @aidaily/cli-bridge && npm run build -w @aidaily/tts && npm run build -w @aidaily/core && npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "vitest run --project core",
    "test:live": "AIDAILY_LIVE=1 vitest run --project core",
    "aidaily": "node apps/cli/dist/index.js",
    "web": "npm run start -w apps/web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
